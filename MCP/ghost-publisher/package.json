{
  "name": "ghost-publisher-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server that lets Claude draft, optimise and (on approval) publish posts to a self-hosted Ghost blog, with a GitHub mirror and push-to-draft sync.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "sync": "node dist/sync.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test test/unit.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tryghost/admin-api": "^1.14.14",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
